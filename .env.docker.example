# ─────────────────────────────────────────────────────────────────────────────
# EmailPOC — Docker environment (EngageLab provider only)
#
# This file has exactly the variables needed to run the whole project with
# Docker Compose using EngageLab as the email provider. Copy it to `.env`,
# fill in the blanks below, then run:
#
#   make up            (or, without make: docker compose up -d --build)
#
# Never commit `.env` — it holds real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── Postgres container ───────────────────────────────────────────────────────
# Read directly by the "db" service in docker-compose.yml. If you change
# POSTGRES_PASSWORD, update DATABASE_URL below to match — they are two
# separate settings, not linked automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emailpoc
# Host port the database is published on. Only needed if you want to connect
# to it yourself (psql, DBeaver, ...) — the app talks to it over Docker's
# internal network instead, using DATABASE_URL below.
POSTGRES_PORT=5433

# Host port the web app is published on. Once `make up` finishes, open
# http://localhost:<this value> in your browser.
APP_PORT=7000


# ── Database (required) ──────────────────────────────────────────────────────
# "db" is the Postgres service name from docker-compose.yml — containers
# reach each other by service name over the internal Docker network, not
# "localhost". Leave this as-is unless you changed POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/emailpoc


# ── Auth / sessions (required) ────────────────────────────────────────────────
# Any random string works. Generate one with: openssl rand -base64 32
SECRET_KEY=change-me-to-a-random-string
SESSION_TTL_DAYS=7
# true = the login cookie is only sent over https. Set to false if you are
# accessing the app over plain http (e.g. http://localhost) — the default
# for a local one-click run.
SESSION_COOKIE_SECURE=false


# ── Provider selection (required) ────────────────────────────────────────────
# Fixed to engagelab — this file only configures that provider.
EMAIL_PROVIDER=engagelab


# ── Logging (optional) ───────────────────────────────────────────────────────
LOG_LEVEL=INFO


# ── Shared / app-wide (required) ─────────────────────────────────────────────
# The (sub)domain whose MX records point at EngageLab, so inbound mail to
# *@INBOUND_DOMAIN reaches the /webhooks/inbound endpoint.
INBOUND_DOMAIN=mail.yourdomain.com

# Verified sender address used in the From header of every outbound RFQ.
FROM_EMAIL=noreply@yourdomain.com

# Display name shown in the From header and the email signature.
COMPANY_NAME=Your Company


# ── EngageLab (required) ──────────────────────────────────────────────────────
# API_USER and API_KEY from the EngageLab dashboard: Send Settings > API_USER
# — create it as "Trigger Email", NOT "Batch". Full setup walkthrough:
# setup_docs/engagelab_guide/engagelab_setup.md
ENGAGELAB_API_USER=
ENGAGELAB_API_KEY=
# Region base URL (optional; Singapore is the default).
# Turkey region: https://emailapi-tr.engagelab.com
ENGAGELAB_API_BASE=https://email.api.engagelab.cc
